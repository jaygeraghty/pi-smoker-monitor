modules = ["python-3.11"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Run smoker monitor"

[[workflows.workflow]]
name = "Run smoker monitor"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv run --no-project --with-editable . smoker"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Run all tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv run --no-project --with pytest --with pytest-asyncio --with-editable . pytest"

[workflows.workflow.metadata]
outputType = "console"
